{
  "expo": {
    "name": "TEA Kids",
    "slug": "tea-mvp-childs",
    "version": "1.1.5",
    "orientation": "default",
    "scheme": "tea-kids",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0F4F8",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F0F4F8",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teakids.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0F4F8",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.teakids.app",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withCrisisWidget",
      "./plugins/withReleaseOptimization",
      "./plugins/withFdroidBuild"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "valdenortavares"
  }
}
